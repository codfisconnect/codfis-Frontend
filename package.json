{
  "name": "codfis-frontend",
  "version": "1.0.0",
  "description": "Codfis Technologies Frontend + Local Backend",
  "scripts": {
    "start:backend": "cd backend && npm install && npm start",
    "start:frontend": "node start-server.js",
    "start": "npm install && npm run start:backend & npm run start:frontend",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "concurrently": "^7.0.0"
  }
}
