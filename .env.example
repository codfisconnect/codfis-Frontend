# Server Configuration
PORT=5050
NODE_ENV=development

# JWT & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
ADMIN_USER=admin
ADMIN_PASS=Admin@Codfis2026!

# Database Options
# For Local Development: leave DATABASE_URL empty to use local SQLite (data.db)
DB_PATH=./data.db
# For Production: provide PostgreSQL connection string (e.g. Neon Free Tier)
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/codfis?sslmode=require

# Storage Options
# For Local Development: files are stored in ./uploads
UPLOAD_DIR=./uploads
# For Production: provide Cloudflare R2 Credentials (S3-compatible API, 10GB Free Tier)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=codfis-resumes
# R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=https://www.codfis.com,https://codfis.com,http://localhost:5050,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
