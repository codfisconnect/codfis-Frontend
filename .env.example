# Server Configuration
PORT=5050
NODE_ENV=development

# JWT & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
ADMIN_USER=admin
ADMIN_PASS=Admin@Codfis2026!

# Database Options
# For Local Development: leave DATABASE_URL empty to use local SQLite (data.db)
DB_PATH=./data.db
# For Production: provide PostgreSQL connection string (Neon Free Tier - completely free, no credit card required)
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/codfis?sslmode=require

# Storage Options
# Local Development: files stored locally in ./uploads
UPLOAD_DIR=./uploads
# Production: Resume uploads & downloads are temporarily disabled on Render Free (ephemeral container, no R2 or paid disk needed)

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=https://www.codfis.com,https://codfis.com,http://localhost:5050,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

